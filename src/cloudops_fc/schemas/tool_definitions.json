[
  {
    "name": "create_ec2_instance",
    "description": "Launch an EC2 instance in the specified region",
    "parameters": {
      "type": "object",
      "properties": {
        "region": {
          "type": "string",
          "enum": [
            "us-east-1",
            "us-east-2",
            "us-west-1",
            "us-west-2",
            "eu-west-1",
            "eu-central-1",
            "eu-west-2",
            "ap-southeast-1",
            "ap-southeast-2",
            "ap-northeast-1",
            "sa-east-1",
            "ca-central-1"
          ],
          "description": "The AWS region where the instance will be launched"
        },
        "instance_type": {
          "type": "string",
          "pattern": "^[a-z][0-9]+\\.(micro|small|medium|large|xlarge|[0-9]+xlarge)$",
          "description": "The EC2 instance type (e.g. t3.micro, m5.large)"
        },
        "ami_id": {
          "type": "string",
          "pattern": "^ami-",
          "description": "The AMI ID to use for the instance"
        },
        "min_count": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Minimum number of instances to launch"
        },
        "max_count": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Maximum number of instances to launch"
        },
        "key_name": {
          "type": "string",
          "description": "The name of the key pair"
        },
        "security_group_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "port": {
                "type": "integer",
                "description": "Port number"
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "tcp",
                  "udp",
                  "icmp"
                ],
                "description": "Network protocol"
              },
              "cidr": {
                "type": "string",
                "description": "CIDR block"
              }
            },
            "required": [
              "port",
              "protocol",
              "cidr"
            ],
            "additionalProperties": false
          },
          "description": "List of security group rules"
        },
        "subnet_id": {
          "type": "string",
          "description": "The subnet ID"
        },
        "associate_public_ip": {
          "type": "boolean",
          "default": false,
          "description": "Whether to associate a public IP address"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "description": "Tag key"
              },
              "value": {
                "type": "string",
                "description": "Tag value"
              }
            },
            "required": [
              "key",
              "value"
            ],
            "additionalProperties": false
          },
          "description": "Tags to assign to the instance"
        }
      },
      "required": [
        "region",
        "instance_type"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "get_billing_alert",
    "description": "Retrieve AWS cost and usage data via Cost Explorer",
    "parameters": {
      "type": "object",
      "properties": {
        "time_period_start": {
          "type": "string",
          "pattern": "\\d{4}-\\d{2}-\\d{2}",
          "description": "Start date (YYYY-MM-DD)"
        },
        "time_period_end": {
          "type": "string",
          "pattern": "\\d{4}-\\d{2}-\\d{2}",
          "description": "End date (YYYY-MM-DD)"
        },
        "granularity": {
          "type": "string",
          "enum": [
            "DAILY",
            "MONTHLY",
            "HOURLY"
          ],
          "description": "Data aggregation granularity"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "BlendedCost",
              "UnblendedCost",
              "UsageQuantity",
              "AmortizedCost",
              "NetUnblendedCost"
            ]
          },
          "description": "Cost/metric types to retrieve"
        },
        "group_by_service": {
          "type": "boolean",
          "description": "Group results by AWS service"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "restart_database",
    "description": "Restart an RDS database instance",
    "parameters": {
      "type": "object",
      "properties": {
        "db_instance_identifier": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+[a-z0-9]$",
          "description": "The DB instance identifier"
        },
        "region": {
          "type": "string",
          "enum": [
            "us-east-1",
            "us-east-2",
            "us-west-1",
            "us-west-2",
            "eu-west-1",
            "eu-central-1",
            "eu-west-2",
            "ap-southeast-1",
            "ap-southeast-2",
            "ap-northeast-1",
            "sa-east-1",
            "ca-central-1"
          ],
          "description": "The AWS region where the DB instance is located"
        },
        "force_failover": {
          "type": "boolean",
          "default": false,
          "description": "Whether to force a failover during restart"
        }
      },
      "required": [
        "db_instance_identifier",
        "region"
      ],
      "additionalProperties": false
    }
  }
]
