{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/cloudops-fc/schemas/restart_database.json",
  "title": "Restart Database",
  "description": "Restart an RDS database instance",
  "type": "object",
  "properties": {
    "db_instance_identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+[a-z0-9]$",
      "description": "The DB instance identifier"
    },
    "region": {
      "type": "string",
      "enum": ["us-east-1", "us-east-2", "us-west-1", "us-west-2", "eu-west-1", "eu-central-1", "eu-west-2", "ap-southeast-1", "ap-southeast-2", "ap-northeast-1", "sa-east-1", "ca-central-1"],
      "description": "The AWS region where the DB instance is located"
    },
    "force_failover": {
      "type": "boolean",
      "default": false,
      "description": "Whether to force a failover during restart"
    }
  },
  "required": ["db_instance_identifier", "region"],
  "additionalProperties": false
}
