# ArcOps — Environment Variables
# Copy to .env and fill in your values. Never commit real credentials.

# ── AWS (used by the TUI/exec layers against LocalStack or real AWS) ──
AWS_REGION=us-east-1
AWS_PROFILE=default
# LocalStack accepts any access key/secret; leave as-is for local testing.
# For real AWS, set real credentials via `aws configure` instead.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ── LocalStack ──
LOCALSTACK_URL=http://localhost:4566
# Optional LocalStack auth token (only needed for a Pro instance).
# If unset, LocalStack runs without an auth token.
# LOCALSTACK_AUTH_TOKEN=

# ── Model inference (ARC_OPS_* overrides) ──
# Model size: 7b (default) or 1.5b. `arcops --light` also selects 1.5b.
# Resolved identically by the CLI, API, and MCP server.
ARC_OPS_MODEL=7b
# HuggingFace adapter repo ID for the fine-tuned LoRA adapter.
# Default (7b): CodeSantiago/arcops. The 1.5b model has NO public adapter:
# set this to your own adapter repo ID to use ARC_OPS_MODEL=1.5b.
ARC_OPS_ADAPTER=CodeSantiago/arcops
# CPU offload folder for the adapter. Defaults to the system temp dir.
# ARC_OPS_OFFLOAD_DIR=

# ── Runtime modes ──
# Set to 1 to allow REAL-AWS mode in repo tools (app.tui / app.exec).
# Real AWS always requires an additional interactive confirmation.
ARC_OPS_REAL=0

# ── REST API security ──
# If set, the API requires the X-API-Key header on /predict and
# /v1/chat/completions. Without it, keep the API bound to localhost only.
# ARC_OPS_API_KEY=

# ── Logging ──
LOG_LEVEL=INFO
